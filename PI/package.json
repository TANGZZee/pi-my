{
  "name": "pi-my",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run check:types && npm run check:svelte",
    "check:types": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --output human",
    "verify": "npm run check && npm run test && npm run build",
    "prepare:runtime": "node scripts/prepare-resources.mjs",
    "prepare:dev": "node scripts/prepare-resources.mjs --sidecar-only",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@tauri-apps/api": "^2.11.1",
