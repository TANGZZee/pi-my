    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.3",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.6"
  }
